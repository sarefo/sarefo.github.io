<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:textSize="20sp"
        android:text="disconnected" />

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="" />

    <Button
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minWidth="200dp"
        android:text="Connect" />

    <TextView
        android:id="@+id/delayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textSize="16sp"
        android:text="sync delay: 0 ms" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button android:id="@+id/dm250" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="−250" />
        <Button android:id="@+id/dm50" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="−50" />
        <Button android:id="@+id/dp50" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="+50" />
        <Button android:id="@+id/dp250" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="+250" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:alpha="0.6"
        android:gravity="center"
        android:text="Raise the delay on the faster phone until both match.\nSaved on this device." />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textSize="12sp"
        android:alpha="0.6"
        android:gravity="center"
        android:text="Plug into the PC with USB debugging enabled.\nThe PC applies the adb tunnel automatically." />
</LinearLayout>
